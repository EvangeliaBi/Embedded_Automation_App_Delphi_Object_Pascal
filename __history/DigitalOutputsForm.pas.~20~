    { Private declarations }
    FCPU : TEmbeddedCPU;
    FOutputShapes : array[8..15] of TShape;
    //
    procedure UpdateOutputs();
  public
    { Public declarations }
    procedure ConnectCPU(ACPU : TEmbeddedCPU);
  end;

var
  frmDigitalOutputs: TfrmDigitalOutputs;

implementation

{$R *.dfm}

{ TfrmDigitalOutputs }

